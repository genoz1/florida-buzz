{
  "name": "florida-buzz",
  "version": "1.0.0",
  "description": "The Florida Buzz - automated Florida lifestyle & travel news site",
  "main": "server.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:schema": "node scripts/verify-schema-contract.js",
    "test:launch-inventory": "node scripts/build-buzz-board-launch.js --check",
    "buzz-social": "node scripts/buzz-board-social.js",
    "buzz-social:dry": "DRY_RUN=true node scripts/buzz-board-social.js",
    "buzz-facebook-sync": "node scripts/sync-facebook-buzz-comments.js",
    "build:launch-inventory": "node scripts/build-buzz-board-launch.js --write",
    "start": "node server.js",
    "automate": "node scripts/automate.js",
    "automate:dry": "DRY_RUN=true node scripts/automate.js",
    "newsletter": "node scripts/newsletter.js",
    "newsletter:dry": "DRY_RUN=true node scripts/newsletter.js",
    "guide-images": "node scripts/generate-guide-images.js",
    "guide:daily": "node scripts/generate-guide.js",
    "guide:daily:dry": "DRY_RUN=true node scripts/generate-guide.js",
    "promo": "node scripts/promo-post.js",
    "promo:dry": "DRY_RUN=true node scripts/promo-post.js",
    "backfill-images": "node scripts/backfill-images.js",
    "backfill-images:dry": "DRY_RUN=true node scripts/backfill-images.js",
    "fix-images": "node scripts/fix-specific-images.js",
    "fix-images:dry": "DRY_RUN=true node scripts/fix-specific-images.js",
    "repair-article-images": "node scripts/repair-article-images.js",
    "crop-image": "node scripts/crop-existing-image.js",
    "city-roundup": "node scripts/city-roundup.js",
    "city-roundup:dry": "DRY_RUN=true node scripts/city-roundup.js",
    "podcast:weekly": "node scripts/podcast-weekly-draft.js",
    "podcast:weekly:force": "FORCE=true node scripts/podcast-weekly-draft.js",
    "podcast:weekly:dry": "DRY_RUN=true node scripts/podcast-weekly-draft.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "image-size": "^1.1.1",
    "jimp": "^1.6.1",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
