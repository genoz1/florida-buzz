# Aligned with Florida Buzz routes: /sponsors, /sponsors/become, /sponsors/packet
# Florida Buzz sponsorship workflow
# Safe template only. Never commit populated secrets.

# Application and URLs
APP_ENV=development
APP_BASE_URL=http://localhost:43350
SPONSOR_SUCCESS_URL=http://localhost:43350/sponsors/become/success?session_id={CHECKOUT_SESSION_ID}
SPONSOR_CANCEL_URL=http://localhost:43350/sponsors/become?canceled=1#apply

# Launch gates — keep false until legal, payment, content, and QA approval
SPONSOR_PAGE_VISIBLE=false
SPONSOR_APPLICATIONS_OPEN=false
SPONSOR_CHECKOUT_ENABLED=false
SPONSOR_METRICS_APPROVED=false

# Legal and customer-facing identity
SPONSOR_LEGAL_ENTITY_NAME=Cartzilla LLC
SPONSOR_PUBLIC_BRAND_NAME=Florida Buzz
SPONSOR_LEGAL_SELLER_LINE=Sponsorships are sold by Cartzilla LLC, doing business as Florida Buzz.
SPONSOR_SUPPORT_EMAIL=REPLACE_WITH_APPROVED_SUPPORT_EMAIL
SPONSOR_TERMS_URL=https://thefloridabuzz.com/terms
SPONSOR_PRIVACY_URL=https://thefloridabuzz.com/privacy
SPONSOR_TERMS_VERSION=REPLACE_WITH_VERSION
SPONSOR_PRIVACY_VERSION=REPLACE_WITH_VERSION

# Tier definitions — one-time annual charges; never trust an amount from the browser
SPONSOR_CURRENCY=usd
SPONSOR_SUPPORTING_AMOUNT_CENTS=58800
SPONSOR_FEATURED_AMOUNT_CENTS=118800
SPONSOR_PREMIER_AMOUNT_CENTS=238800
SPONSOR_SUPPORTING_MONTHLY_EQUIVALENT_CENTS=4900
SPONSOR_FEATURED_MONTHLY_EQUIVALENT_CENTS=9900
SPONSOR_PREMIER_MONTHLY_EQUIVALENT_CENTS=19900
SPONSOR_SUPPORTING_CAP=6
SPONSOR_FEATURED_CAP=4
SPONSOR_PREMIER_CAP=2

# Dedicated Florida Buzz Stripe account only.
# Use matching mode everywhere: sk_live + pk_live + live price IDs, or
# sk_test + pk_test + test price IDs. Mixing modes will fail checkout.
STRIPE_EXPECTED_ACCOUNT_ID=acct_1UQUAyANlemH6ld3
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_FROM_FLORIDA_BUZZ
STRIPE_SECRET_KEY=sk_live_REPLACE_FROM_FLORIDA_BUZZ
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_FROM_FLORIDA_BUZZ_ENDPOINT
# Product/price IDs below were created in Stripe test mode. If DigitalOcean
# is on a live secret key, replace all six with live-mode IDs from the
# Florida Buzz Stripe Dashboard (Products → each tier → Price ID).
STRIPE_PRODUCT_SUPPORTING=prod_REPLACE_LIVE_OR_KEEP_TEST
STRIPE_PRODUCT_FEATURED=prod_REPLACE_LIVE_OR_KEEP_TEST
STRIPE_PRODUCT_PREMIER=prod_REPLACE_LIVE_OR_KEEP_TEST
STRIPE_PRICE_SUPPORTING=price_REPLACE_LIVE_SUPPORTING
STRIPE_PRICE_FEATURED=price_REPLACE_LIVE_FEATURED
STRIPE_PRICE_PREMIER=price_1UQUyBANlemH6ld3hg5ovGrM
# Previous test-mode references (do not use with sk_live_):
# STRIPE_PRODUCT_SUPPORTING=prod_VRN3YgsL1s5KHW
# STRIPE_PRODUCT_FEATURED=prod_VRN3UjopCJxVa9
# STRIPE_PRODUCT_PREMIER=prod_VRN3LwTygs37tS
# STRIPE_PRICE_SUPPORTING=price_1UQUIwANlemH6ld3oB46y3ST
# STRIPE_PRICE_FEATURED=price_1UQUJBANlemH6ld30mQHn9nj
# STRIPE_PRICE_PREMIER=price_1UQUJNANlemH6ld3BetxEAW8

# Persistence — use the site's existing database if present
DATABASE_URL=REPLACE_WITH_SERVER_ONLY_DATABASE_URL
DATABASE_DIRECT_URL=REPLACE_IF_THE_PROVIDER_REQUIRES_A_DIRECT_MIGRATION_URL

# Private logo storage — use existing private object storage if present
SPONSOR_UPLOAD_PROVIDER=s3
SPONSOR_UPLOAD_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
SPONSOR_UPLOAD_REGION=REPLACE_WITH_REGION
SPONSOR_UPLOAD_ENDPOINT=REPLACE_IF_USING_AN_S3_COMPATIBLE_PROVIDER
SPONSOR_UPLOAD_ACCESS_KEY_ID=REPLACE_SERVER_ONLY
SPONSOR_UPLOAD_SECRET_ACCESS_KEY=REPLACE_SERVER_ONLY
SPONSOR_UPLOAD_MAX_BYTES=5242880
SPONSOR_UPLOAD_SIGNED_URL_TTL_SECONDS=900

# Transactional notifications — use the site's existing provider if present
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_REPLACE_SERVER_ONLY
SPONSOR_EMAIL_FROM=Florida Buzz Sponsorships <REPLACE_WITH_VERIFIED_SENDER>
SPONSOR_ADMIN_NOTIFICATION_EMAILS=REPLACE_WITH_COMMA_SEPARATED_APPROVED_RECIPIENTS

# Admin access and application security
SPONSOR_ADMIN_EMAILS=REPLACE_WITH_COMMA_SEPARATED_ADMIN_EMAILS
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SPONSOR_UPLOAD_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SPONSOR_WEBHOOK_IDEMPOTENCY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Audience evidence and analytics
SPONSOR_APPROVED_METRICS_PATH=content/sponsor-metrics.approved.json
NEXT_PUBLIC_GA4_MEASUREMENT_ID=REPLACE_WITH_EXISTING_SITE_VALUE

# Optional malware-scanning service. Required before enabling uploads in production
SPONSOR_FILE_SCAN_PROVIDER=REPLACE_WITH_PROVIDER
SPONSOR_FILE_SCAN_API_KEY=REPLACE_SERVER_ONLY
