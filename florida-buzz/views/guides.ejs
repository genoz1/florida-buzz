<%- include('partials/header', { pageTitle: 'Florida Travel Guides' + (pagination.page > 1 ? ' — Page ' + pagination.page : '') + ' — The Florida Buzz', pageDescription: 'In-depth, evergreen guides to Florida — springs, theme parks, beaches, and more.', category: null, tickerItems: ticker, canonicalPath }) %>

<main class="wrap">
  <section class="section" style="border-bottom:none; padding-bottom:0;">
    <span class="eyebrow">Guides</span>
    <h1 style="font-family:var(--font-display); font-size:34px; color:var(--teal-900); margin:8px 0 0;">Florida Travel Guides</h1>
    <p style="color:var(--ink-600); margin-top:10px; max-width:640px;">Practical guides to Florida trips, park visits, beaches and travel logistics.</p>
    <% if (pagination.page === 1 && typeof guideHubs !== 'undefined' && guideHubs.length) { %>
    <nav aria-label="Guide collections" style="margin-top:18px;">
      <% guideHubs.forEach(hub => { %><p><a href="<%= hub.href %>" style="color:var(--teal-900); font-weight:600;"><%= hub.title %> →</a></p><% }) %>
    </nav>
    <% } %>
  </section>

  <section class="section">
    <% if (!guides.length) { %>
      <p style="color:var(--ink-600);">No guides published yet — check back soon.</p>
    <% } else { %>
    <div class="grid">
      <% guides.forEach(g => { %>
        <a href="/article/<%= g.slug %>" class="card">
          <div class="card-image"><img src="<%= thumbUrl(g.image_url) || placeholderImg(g.category) %>" alt="<%= g.title %>" width="480" height="300" loading="lazy" onerror="this.onerror=null;this.src='<%= placeholderImg(g.category) %>';"></div>
          <span class="tag"><%= categoryLabels[g.category] %></span>
          <h3><%= g.title %></h3>
          <p class="dek-sm"><%= g.dek %></p>
        </a>
      <% }) %>
    </div>
    <% if (pagination.totalPages > 1) { %>
    <nav class="archive-pagination" aria-label="Guide pages" style="margin-top:28px; display:flex; gap:16px; flex-wrap:wrap; align-items:center;">
      <% if (pagination.page > 1) { %><a href="/guides">All guides</a><% } %>
      <% if (pagination.prevHref) { %><a href="<%= pagination.prevHref %>" rel="prev">← Newer</a><% } %>
      <span>Page <%= pagination.page %> of <%= pagination.totalPages %></span>
      <% if (pagination.nextHref) { %><a href="<%= pagination.nextHref %>" rel="next">Older →</a><% } %>
    </nav>
    <% } %>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
