<%- include('partials/header', {
  pageTitle: 'The Florida Buzz — Florida Theme Parks, Beaches, Space & More',
  pageDescription: 'Florida theme park news with story photography, original guides by Gene Zentko, Disney planning tools, and the Florida Buzz: Disney podcast hosted by Geno.',
  category: null,
  tickerItems: [],
  canonicalPath: '/',
  compactHomeNav: true
}) %>
<%# Previous news-feed layout saved at views/home-news-feed-backup.ejs — see docs/homepage-restore.md %>
<link rel="stylesheet" href="/css/podcasts.css">

<main class="wrap home-main">

  <section class="section home-featured" aria-labelledby="home-featured-heading">
    <div class="home-featured-intro">
      <p class="home-kicker"><span class="home-kicker-dot" aria-hidden="true"></span> The latest from the parks</p>
      <h1 id="home-featured-heading" class="home-featured-title">Disney, Universal, and the stories worth knowing.</h1>
    </div>

    <% if (featuredLead) { %>
    <div class="home-feature-split">
      <a href="/article/<%= featuredLead.slug %>" class="home-feature-lead">
        <div class="home-feature-media home-feature-media-lead">
          <img
            src="<%= featuredLead.image_url || placeholderImg(featuredLead.category) %>"
            alt="<%= featuredLead.title %>"
            width="960"
            height="540"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            onerror="this.onerror=null;this.src='<%= placeholderImg(featuredLead.category) %>';"
          >
        </div>
        <div class="home-feature-copy">
          <div class="home-story-meta">
            <span class="home-place-tag"><%= homePlaceTag(featuredLead) %></span>
            <% if (featuredLead.published_at && formatPubDate(featuredLead.published_at)) { %>
              <time class="home-pub-date" datetime="<%= new Date(featuredLead.published_at).toISOString() %>"><%= formatPubDate(featuredLead.published_at) %></time>
            <% } %>
          </div>
          <h2 class="home-feature-headline"><%= featuredLead.title %></h2>
          <% if (featuredLead.dek) { %><p class="home-feature-dek"><%= featuredLead.dek %></p><% } %>
        </div>
      </a>

      <% if (featuredSide && featuredSide.length) { %>
      <div class="home-feature-side">
        <% featuredSide.forEach(a => { %>
          <a href="/article/<%= a.slug %>" class="home-feature-side-card">
            <div class="home-feature-media home-feature-media-side">
              <img
                src="<%= thumbUrl(a.image_url) || placeholderImg(a.category) %>"
                alt="<%= a.title %>"
                width="480"
                height="270"
                loading="lazy"
                decoding="async"
                onerror="this.onerror=null;this.src='<%= placeholderImg(a.category) %>';"
              >
            </div>
            <div class="home-feature-copy">
              <span class="home-place-tag"><%= homePlaceTag(a) %></span>
              <h3 class="home-feature-side-headline"><%= a.title %></h3>
              <% if (a.published_at && formatPubDate(a.published_at)) { %>
                <time class="home-pub-date" datetime="<%= new Date(a.published_at).toISOString() %>"><%= formatPubDate(a.published_at) %></time>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
      <% } %>
    </div>
    <% } else { %>
      <p class="home-section-lede">Fresh theme park stories will show up here as soon as they publish.</p>
    <% } %>
  </section>

  <section class="home-plan-bar" aria-label="Plan your park day">
    <div class="home-plan-bar-inner">
      <p class="home-plan-label"><span class="home-plan-bar-mark" aria-hidden="true"></span> Plan your park day</p>
      <nav class="home-plan-links">
        <a href="/wait-times">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v4l2.5 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Wait Times <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/planner">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 3v4M16 3v4M4 10h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Day Planner <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/dining">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3v10M7 13c0 2 1.5 3 3 3h1M17 3v18M14 3c0 3 3 4 3 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Dining Guides <span aria-hidden="true">&rarr;</span>
        </a>
        <a href="/buzz">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="9" cy="10" r="3" stroke="currentColor" stroke-width="1.8"/><circle cx="16" cy="11" r="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 19c1.2-2.4 3.2-3.5 5.5-3.5s4.3 1.1 5.5 3.5M13.5 19c.7-1.4 1.9-2.2 3.4-2.2 1.3 0 2.4.6 3.1 1.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          Buzz Board <span aria-hidden="true">&rarr;</span>
        </a>
      </nav>
    </div>
    <% if (typeof planningOffers !== 'undefined' && planningOffers && planningOffers.length) { %>
      <%- include('partials/planning-offers', { planningOffers, planningOffersVariant: 'home' }) %>
    <% } else if (typeof undercoverTouristUrl === 'string' && undercoverTouristUrl) { %>
    <aside class="home-partner-strip" aria-label="Ticket and hotel partner">
      <div class="home-partner-copy">
        <span class="home-tool-kicker">Book tickets &amp; hotels</span>
        <strong>Undercover Tourist</strong>
        <p>Compare Disney World ticket and hotel deals before you lock in dates — a Florida Buzz planning partner.</p>
        <p class="home-partner-disclosure">Affiliate disclosure: we may earn a commission if you book through this link, at no extra cost to you.</p>
      </div>
      <a class="btn" href="<%= undercoverTouristUrl %>" target="_blank" rel="nofollow sponsored noopener">Check deals at Undercover Tourist &rarr;</a>
    </aside>
    <% } %>
  </section>

  <% if (moreThemeParks && moreThemeParks.length) { %>
  <section class="section home-theme-more" aria-labelledby="home-theme-more-heading">
    <div class="section-head">
      <h2 id="home-theme-more-heading" class="home-section-display">More from the parks</h2>
      <a class="home-section-link" href="/category/theme-parks">All theme park news &rarr;</a>
    </div>
    <div class="grid home-story-grid home-story-grid-3">
      <% moreThemeParks.forEach(a => { %>
        <a href="/article/<%= a.slug %>" class="card home-story-card">
          <div class="card-image home-story-card-image">
            <img
              src="<%= thumbUrl(a.image_url) || placeholderImg(a.category) %>"
              alt="<%= a.title %>"
              width="480"
              height="270"
              loading="lazy"
              decoding="async"
              onerror="this.onerror=null;this.src='<%= placeholderImg(a.category) %>';"
            >
          </div>
          <span class="home-place-tag"><%= homePlaceTag(a) %></span>
          <h3><%= a.title %></h3>
          <% if (a.published_at && formatPubDate(a.published_at)) { %>
            <time class="home-pub-date" datetime="<%= new Date(a.published_at).toISOString() %>"><%= formatPubDate(a.published_at) %></time>
          <% } %>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (typeof socialProfiles !== 'undefined' && socialProfiles && socialProfiles.length) { %>
  <section class="section home-social-follow" aria-labelledby="home-social-heading">
    <div class="home-social-follow-panel">
      <p class="home-social-kicker"><span class="home-social-kicker-bar" aria-hidden="true"></span> Stay connected</p>
      <h2 id="home-social-heading" class="home-social-title">Follow Florida Buzz</h2>
      <p class="home-social-lede">Keep up with Florida Buzz between visits.</p>
      <nav class="home-social-buttons" aria-label="Follow Florida Buzz on social media">
        <% socialProfiles.forEach(function (profile) { %>
          <a
            class="home-social-btn"
            href="<%= profile.href %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            <%- include('partials/social-platform-icon', { platformId: profile.id }) %>
            <span class="home-social-btn-label"><%= profile.label %></span>
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        <% }) %>
      </nav>
    </div>
  </section>
  <% } %>

  <% if (exploreTiles && exploreTiles.length) { %>
  <section class="section home-explore" id="explore-florida" aria-labelledby="home-explore-heading">
    <div class="section-head">
      <h2 id="home-explore-heading" class="home-section-display">Explore more of Florida</h2>
    </div>
    <div class="home-explore-grid">
      <% exploreTiles.forEach(tile => { %>
        <a href="<%= tile.href %>" class="home-explore-tile">
          <span class="home-explore-media">
            <img
              src="<%= thumbUrl(tile.image_url) || placeholderImg(tile.category) %>"
              alt="<%= tile.image_alt %>"
              width="480"
              height="360"
              loading="lazy"
              decoding="async"
              onerror="this.onerror=null;this.src='<%= placeholderImg(tile.category) %>';"
            >
          </span>
          <span class="home-explore-label"><%= tile.label %></span>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (guides && guides.length) { %>
  <section class="section home-guides" aria-labelledby="home-guides-heading">
    <div class="section-head">
      <h2 id="home-guides-heading" class="home-section-display">Original guides</h2>
      <a class="home-section-link" href="/guides">All guides &rarr;</a>
    </div>
    <p class="home-section-lede">In-depth Florida planning pages researched and bylined by <a href="/gene-zentko">Gene Zentko</a>.</p>
    <div class="grid">
      <% guides.forEach(g => { %>
        <a href="/article/<%= g.slug %>" class="card">
          <div class="card-image">
            <img
              src="<%= thumbUrl(g.image_url) || placeholderImg(g.category) %>"
              alt="<%= g.title %>"
              width="480"
              height="300"
              loading="lazy"
              decoding="async"
              onerror="this.onerror=null;this.src='<%= placeholderImg(g.category) %>';"
            >
          </div>
          <span class="tag"><%= categoryLabels[g.category] || 'Guide' %></span>
          <h3><%= g.title %></h3>
          <p class="dek-sm"><%= g.dek %></p>
          <p class="byline">By Gene Zentko</p>
        </a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (podcastShow) { %>
  <section class="section home-podcast" aria-labelledby="home-podcast-heading">
    <div class="section-head">
      <h2 id="home-podcast-heading" class="home-section-display">Podcast</h2>
      <a class="home-section-link" href="/podcasts/<%= podcastShow.slug %>">Show &amp; episode archive &rarr;</a>
    </div>
    <div class="home-podcast-panel">
      <a class="home-podcast-art" href="/podcasts/<%= podcastShow.slug %>">
        <img
          src="<%= podcastShow.cover_url || '/img/podcasts/florida-buzz-disney-cover.jpg' %>"
          alt="<%= podcastShow.cover_alt || (podcastShow.title + ' cover art') %>"
          width="220"
          height="220"
          loading="lazy"
          decoding="async"
        >
      </a>
      <div>
        <p class="eyebrow">Hosted by Geno</p>
        <p class="home-podcast-title"><a href="/podcasts/<%= podcastShow.slug %>"><%= podcastShow.title %></a></p>
        <p class="home-section-lede"><%= podcastShow.description %></p>
        <% if (podcastLatest) { %>
          <p class="podcast-latest-label">Latest episode</p>
          <p class="home-podcast-ep"><a href="/podcasts/<%= podcastShow.slug %>/<%= podcastLatest.slug %>"><%= podcastLatest.title %></a></p>
          <% if (podcastLatest.audio_url) { %>
            <%- include('partials/podcast-player', { audioUrl: podcastLatest.audio_url }) %>
          <% } %>
        <% } %>
        <% if (podcastRecent && podcastRecent.length) { %>
          <p class="podcast-latest-label" style="margin-top:18px;">Recent episodes</p>
          <ul class="home-podcast-archive">
            <% podcastRecent.forEach(ep => { %>
              <li>
                <a href="/podcasts/<%= podcastShow.slug %>/<%= ep.slug %>"><%= ep.title %></a>
                <% if (ep.published_at) { %>
                  <span class="byline"><%= new Date(ep.published_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
        <%- include('partials/podcast-platform-badges', { links: podcastPlatformLinks || [] }) %>
        <p class="podcast-links" style="margin-top:16px;">
          <a class="btn" href="/podcasts/<%= podcastShow.slug %>">Browse all episodes</a>
          <a class="btn btn-outline" href="/podcasts">Podcast directory</a>
        </p>
      </div>
    </div>
  </section>
  <% } %>

  <section class="section home-newsletter-cta" id="newsletter" aria-labelledby="home-newsletter-heading">
    <div class="home-newsletter-panel">
      <div>
        <h2 id="home-newsletter-heading" class="home-newsletter-title">The Buzz, in your inbox</h2>
        <p>One email a day — Florida news, planning guides, and park tips worth your time.</p>
      </div>
      <form class="newsletter-form home-newsletter-form" action="/subscribe" method="POST">
        <label class="visually-hidden" for="homeNewsletterEmail">Email address</label>
        <input id="homeNewsletterEmail" type="email" name="email" placeholder="you@email.com" required>
        <input type="text" name="website" style="position:absolute; left:-9999px;" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="hidden" name="form_rendered_at" value="<%= Date.now() %>">
        <input type="hidden" name="return_to" value="/">
        <input type="hidden" name="source" value="home">
        <button type="submit" class="btn">Subscribe</button>
      </form>
    </div>
  </section>

</main>

<%- include('partials/footer', { hideFooterNewsletter: true }) %>
