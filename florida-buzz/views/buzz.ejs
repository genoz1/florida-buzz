<%- include('partials/header', {
  pageTitle: 'The Buzz Board — Florida Buzz',
  pageDescription: 'Florida questions, answered by verified Florida Buzz readers.',
  canonicalPath: '/buzz',
  category: null,
  isBuzzPage: true,
  robots: 'noindex,follow'
}) %>

<main class="buzz-shell" data-analytics-view="buzz_board_view">
  <section class="buzz-masthead">
    <div class="buzz-masthead-glow" aria-hidden="true"></div>
    <div class="wrap buzz-masthead-inner">
      <p class="buzz-kicker">Florida Buzz asks. Verified readers answer.</p>
      <h1>The Buzz Board</h1>
      <p class="buzz-tagline">Florida’s conversation starts here.</p>
      <p class="buzz-intro">Big park opinions, cruise questions, and the Florida things everyone has a take on—organized around one good question at a time.</p>
    </div>
  </section>

  <div class="wrap buzz-feed-wrap">
    <nav class="buzz-filter-bar" aria-label="Buzz Board filters">
      <% [
        ['buzzing', 'Buzzing'], ['latest', 'Latest'], ['disney', 'Disney'],
        ['universal', 'Universal'], ['cruises', 'Cruises'], ['florida-life', 'Florida Life']
      ].forEach(([value, label]) => { %>
        <a href="/buzz?filter=<%= value %>" class="buzz-filter <%= filter === value ? 'active' : '' %>" data-filter-name="<%= value %>" <%= filter === value ? 'aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
    </nav>

    <% if (featured) { %>
      <section class="buzz-featured" aria-labelledby="featured-question">
        <div class="buzz-featured-copy">
          <div class="buzz-card-topline">
            <span class="buzz-category buzz-category--<%= featured.category %>"><%= categoryLabels[featured.category] %></span>
            <span class="buzz-live-dot"><span aria-hidden="true"></span> Active conversation</span>
          </div>
          <a href="/buzz/<%= featured.slug %>" class="buzz-question-link">
            <h2 id="featured-question"><%= featured.question %></h2>
          </a>
          <% if (featured.context) { %><p><%= featured.context %></p><% } %>
          <div class="buzz-card-stats">
            <span><strong><%= featured.response_count %></strong> <%= Number(featured.response_count) === 1 ? 'response' : 'responses' %></span>
            <span><strong><%= featured.unique_participant_count %></strong> voices</span>
            <span>Active <%= timeAgo(featured.last_activity_at) %></span>
          </div>
          <a class="buzz-join-link" href="/buzz/<%= featured.slug %>">See what readers are saying <span aria-hidden="true">→</span></a>
        </div>
        <div class="buzz-featured-mark" aria-hidden="true">?</div>
      </section>
    <% } %>

    <section class="buzz-feed" aria-labelledby="feed-heading">
      <div class="buzz-feed-heading">
        <div>
          <p class="buzz-section-label"><%= filter === 'buzzing' ? 'Reader activity, ranked honestly' : filter === 'latest' ? 'Newest questions and activity' : categoryLabels[filter] + ' conversations' %></p>
          <h2 id="feed-heading"><%= filter === 'buzzing' ? (featured ? 'More conversations' : 'Questions worth answering') : filter === 'latest' ? 'Latest on the Board' : categoryLabels[filter] %></h2>
        </div>
        <% if (user) { %><span class="buzz-signed-in">Signed in as <strong><%= user.displayName %></strong></span><% } %>
      </div>

      <% if (!discussions.length) { %>
        <div class="buzz-empty">
          <span class="buzz-empty-icon" aria-hidden="true">✦</span>
          <h3>No conversations here yet.</h3>
          <p>Florida Buzz will add a thoughtful question when there is something genuinely worth discussing.</p>
          <a href="/buzz?filter=latest">See the latest questions</a>
        </div>
      <% } else { %>
        <div class="buzz-card-grid">
          <% discussions.forEach(discussion => { %>
            <article class="buzz-card buzz-card--<%= discussion.category %>">
              <div class="buzz-card-accent" aria-hidden="true"></div>
              <div class="buzz-card-topline">
                <span class="buzz-category buzz-category--<%= discussion.category %>"><%= categoryLabels[discussion.category] %></span>
                <span class="buzz-time"><%= Number(discussion.response_count) === 0 ? 'Posted' : 'Active' %> <%= timeAgo(discussion.last_activity_at) %></span>
              </div>
              <a href="/buzz/<%= discussion.slug %>" class="buzz-question-link"><h3><%= discussion.question %></h3></a>
              <% if (discussion.context) { %><p class="buzz-card-context"><%= discussion.context %></p><% } %>
              <div class="buzz-card-footer">
                <% if (Number(discussion.response_count) === 0) { %>
                  <span class="buzz-first-voice">Be the first to weigh in</span>
                <% } else { %>
                  <span><strong><%= discussion.response_count %></strong> <%= Number(discussion.response_count) === 1 ? 'response' : 'responses' %></span>
                  <span><strong><%= discussion.reaction_count %></strong> likes</span>
                <% } %>
                <a href="/buzz/<%= discussion.slug %>" aria-label="Open discussion: <%= discussion.question %>">Join in <span aria-hidden="true">→</span></a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</main>

<script src="/js/buzz-board.js" defer></script>
<%- include('partials/footer') %>
