<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= episode.title %> — Podcast admin</title>
  <style>
    body{max-width:980px;margin:40px auto;padding:20px;font:16px system-ui;color:#182a34}
    a{color:#00697b}.notice{padding:14px;background:#eef5f6;margin:12px 0}.error{padding:14px;background:#fde8e4;margin:12px 0}
    .btn{display:inline-block;background:#0e3b43;color:#fff;padding:10px 14px;text-decoration:none;border:0;cursor:pointer;margin:4px 4px 4px 0}
    .btn-secondary{background:#4a5350}
    label{display:block;margin:10px 0 4px} input,textarea,select{width:100%;padding:8px;box-sizing:border-box}
    form.card,section.card{border:1px solid #ddd;padding:16px;margin:20px 0}
    .status{font-weight:700;text-transform:uppercase}
    audio{width:100%;margin-top:8px}
    ul.jobs{font-size:14px}
    .audio-live{background:#e7f7ee;border:1px solid #9dceb0}
    .audio-stalled,.audio-failed{background:#fde8e4;border:1px solid #e2a59a}
    .audio-done{background:#eef5f6;border:1px solid #b7c9cd}
    .audio-uncertain,.audio-idle{background:#fff8e8;border:1px solid #e2d2a8}
    #audioStatusPanel{padding:14px;margin:12px 0}
    #audioStatusPanel strong{display:block;margin-bottom:6px}
    .btn[disabled]{opacity:.65;cursor:wait}
    .yt-live{background:#e7f7ee;border:1px solid #9dceb0}
    .yt-stalled,.yt-failed{background:#fde8e4;border:1px solid #e2a59a}
    .yt-done{background:#eef5f6;border:1px solid #b7c9cd}
    .yt-ready{background:#e8f3f6;border:1px solid #9dbdca}
    .yt-uncertain,.yt-idle{background:#fff8e8;border:1px solid #e2d2a8}
    #youtubeStatusPanel{padding:14px;margin:0 0 16px}
    #youtubeStatusPanel strong{display:block;margin-bottom:6px}
    .yt-meter{height:14px;background:#d9e3e6;border-radius:7px;overflow:hidden;margin:10px 0 6px}
    .yt-meter > span{display:block;height:100%;background:#0e3b43;width:0%;transition:width .4s ease}
    .yt-meter-live > span{background:#1f7a4c}
    .yt-meter-failed > span{background:#a94442}
    .yt-meta{font-size:13px;color:#4a5350}
    .still-bulk-bar{position:sticky;top:0;z-index:5;background:#f4f8f9;border:1px solid #c5d4d8;padding:12px 14px;margin:16px 0 0;display:flex;flex-wrap:wrap;gap:10px 16px;align-items:flex-end}
    .still-bulk-bar label.inline{display:inline-flex;align-items:center;gap:8px;margin:0;font-size:14px;cursor:pointer}
    .still-bulk-bar label.inline input{width:auto;margin:0}
    .still-bulk-bar .bulk-note{flex:1 1 220px;min-width:180px;margin:0}
    .still-bulk-bar .bulk-note textarea{margin-top:4px;min-height:44px}
    .still-card{position:relative;border:1px solid #ccd6d9;padding:12px;background:#fafcfc}
    .still-card.selected{border-color:#0e3b43;box-shadow:inset 0 0 0 1px #0e3b43}
    .still-select{position:absolute;top:10px;left:10px;z-index:2;display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.92);border:1px solid #ccd6d9;padding:4px 8px;font-size:12px;font-weight:600;cursor:pointer}
    .still-select input{width:auto;margin:0;cursor:pointer}
  </style>
</head>
<body>
  <p><a href="/admin/podcasts">&larr; All episodes</a></p>
  <h1><%= episode.title %></h1>
  <% const releaseDayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; %>
  <% const intendedDay = episode.intended_publish_weekday != null
      ? releaseDayNames[episode.intended_publish_weekday]
      : (episode.outline_json && episode.outline_json.release_label) || null; %>
  <p>Status: <span class="status"><%= episode.status %></span>
    <% if (episode.week_key) { %> · Week <code><%= episode.week_key %></code><% } %>
    <% if (intendedDay) { %> · Intended <strong><%= intendedDay %></strong> release (manual; auto-publish off)<% } %>
  </p>
  <% if (notice) { %><p class="notice"><%= notice %></p><% } %>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <% if (episode.last_error) { %><p class="error"><strong>Last error:</strong> <%= episode.last_error %></p><% } %>
  <% const scriptShown = (typeof conversation !== 'undefined' && conversation && conversation.content_text) ? conversation.content_text : (episode.script_text || ''); %>
  <% const isScaffold = /scaffold for review|not for publication until approved/i.test(scriptShown); %>
  <% if (isScaffold) { %>
    <p class="error">
      <strong>This is only a short scaffold (~2 minutes), not the full ~20–25 minute episode.</strong>
      The script box below is cleared on purpose so the next click asks AI for a full script.
      Click <strong>Save / generate script</strong> and wait a few minutes — do not Approve or Publish until
      a long solo Geno script appears in the box, then click <strong>Generate private preview (ElevenLabs TTS)</strong>
      (scaffold scripts never auto-generate audio).
    </p>
  <% } else if (notice === 'script-generated') { %>
    <p class="notice">Full AI script generated. If auto-preview is on, private audio may already be generating — wait for <code>preview_ready</code>, or click Generate private preview if needed.</p>
  <% } %>
  <p class="notice"><%= show.disclosure %></p>
  <p class="notice">This is a <strong>standalone</strong> weekly episode (not Part 1/Part 2 of another show). With generation enabled, private preview audio usually starts automatically after a full script — listen at <code>preview_ready</code>, then Approve → Publish. Intended release is <%= intendedDay || 'Tuesday or Friday' %> 6:00 AM ET after manual approval — auto-publish is off. Target length is about 20–25 minutes once the full AI script + audio succeed.</p>

  <form class="card" method="post" action="/admin/podcasts/episodes/<%= episode.id %>">
    <h2>Episode details</h2>
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <label>Title <input name="title" value="<%= episode.title %>" required></label>
    <label>Slug <input name="slug" value="<%= episode.slug %>"></label>
    <label>Episode number <input name="episode_number" type="number" min="1" value="<%= episode.episode_number || '' %>"></label>
    <label>Description <textarea name="description" rows="3" required><%= episode.description %></textarea></label>
    <label>Show notes (HTML)
      <textarea name="show_notes_html" rows="8"><%= episode.show_notes_html || '' %></textarea>
      <small>On save, affiliation + AI host/anecdote disclosures are appended if missing. Do not auto-publish.</small>
    </label>
    <label>Artwork alt text <input name="artwork_alt" value="<%= episode.artwork_alt || '' %>"></label>
    <button class="btn" type="submit">Save draft fields</button>
  </form>

  <section class="card">
    <h2>Sources</h2>
    <p>Review weekly articles, guides, Buzz Board questions, and evergreen topics. Exclude or remove before regenerating the script.</p>
    <ul>
      <% sources.forEach(src => { %>
        <li>
          <span class="status" style="font-size:12px"><%= src.source_kind || 'custom' %></span>
          <strong><%= src.title %></strong> —
          <a href="<%= src.url %>" target="_blank" rel="noopener"><%= src.url %></a>
          <% if (!src.included) { %> (excluded)<% } %>
          <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/sources/<%= src.id %>/toggle" style="display:inline">
            <input type="hidden" name="csrf" value="<%= csrf %>">
            <input type="hidden" name="included" value="<%= src.included ? 'false' : 'true' %>">
            <button class="btn btn-secondary" type="submit"><%= src.included ? 'Exclude' : 'Include' %></button>
          </form>
          <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/sources/<%= src.id %>/delete" style="display:inline">
            <input type="hidden" name="csrf" value="<%= csrf %>">
            <button class="btn btn-secondary" type="submit">Remove</button>
          </form>
        </li>
      <% }) %>
    </ul>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/sources/custom">
      <h3>Add guide, Buzz Board question, evergreen topic, or custom source</h3>
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <label>Kind
        <select name="source_kind">
          <option value="guide">Guide</option>
          <option value="buzz_board">Buzz Board question</option>
          <option value="evergreen_topic">Evergreen topic</option>
          <option value="article">Article</option>
          <option value="custom">Custom topic</option>
        </select>
      </label>
      <label>Title <input name="title" required placeholder="Paraphrased Buzz Board question or topic title"></label>
      <label>URL <input name="url" type="url" required placeholder="https://thefloridabuzz.com/..."></label>
      <label>Summary <textarea name="summary" rows="2"></textarea></label>
      <label>External ref (optional) <input name="external_ref" placeholder="article id, buzz slug, topic slug"></label>
      <p>Suggested evergreen topics:
        <% evergreenTopics.forEach((t, i) => { %><code><%= t.slug %></code><%= i < evergreenTopics.length - 1 ? ', ' : '' %><% }) %>
      </p>
      <button class="btn" type="submit">Add source</button>
    </form>
  </section>

  <form class="card" method="post" action="/admin/podcasts/episodes/<%= episode.id %>/outline">
    <h2>Outline</h2>
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <label>Outline text (leave blank to generate with AI text service)
      <textarea name="outline_text" rows="8"><%= outline ? outline.content_text : (episode.outline_json && episode.outline_json.text) || '' %></textarea>
    </label>
    <button class="btn" type="submit">Save / generate outline</button>
  </form>

  <form class="card" method="post" action="/admin/podcasts/episodes/<%= episode.id %>/script" data-long-job="script">
    <h2>Conversation script</h2>
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <label>Script (Geno: lines; leave blank to generate the full ~20–25 minute solo episode)
      <textarea name="script_text" rows="16"><%= isScaffold ? '' : scriptShown %></textarea>
      <small>
        <% if (isScaffold) { %>Scaffold text was cleared above so Generate will create a real full script. <% } else if (scriptShown) { %>Script loaded (<%= String(scriptShown).trim().split(/\s+/).filter(Boolean).length %> words). <% } %>
        Full episodes: solo Geno — named open (Option A) + quick hits + one deep dive + CTA. Wait for the page to finish — script generation is slow.
      </small>
    </label>
    <button class="btn" type="submit">Save / generate script</button>
  </form>

  <section class="card">
    <h2>Audio</h2>
    <% const ap = typeof audioProgress !== 'undefined' && audioProgress ? audioProgress : { state: 'idle', label: 'No audio generation in progress', detail: '', sectionLabel: null }; %>
    <div id="audioStatusPanel" class="audio-<%= ap.state %>" data-episode-id="<%= episode.id %>">
      <strong id="audioStatusLabel"><%= ap.label %></strong>
      <p id="audioStatusDetail" style="margin:0 0 8px"><%= ap.detail %></p>
      <p id="audioStatusMeta" style="margin:0;color:#5b6b73;font-size:0.95rem">
        Episode status: <code id="audioEpisodeStatus"><%= episode.status %></code>
        · <span id="audioSectionLabel"><%= ap.sectionLabel || 'no active section' %></span>
        · heartbeat age: <span id="audioHeartbeatAge"><%= ap.ageMs == null ? 'n/a' : Math.round(ap.ageMs / 1000) + 's' %></span>
      </p>
    </div>
    <% if (episode.audio_url) { %>
      <p>Current master (permanent URL preferred):</p>
      <audio id="episodeAudio" controls preload="metadata" src="<%= episode.audio_url %>"></audio>
      <p>
        <a class="btn btn-secondary" href="/admin/podcasts/episodes/<%= episode.id %>/audio" target="_blank" rel="noopener">Preview / download audio</a>
      </p>
    <% } else { %>
      <p id="noAudioYet">No master audio yet.</p>
    <% } %>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/generate-audio" id="generateAudioForm">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn" type="submit" id="generateAudioBtn" <%= cfg.generation ? '' : 'disabled' %>>Generate private preview (<%= cfg.ttsProvider === 'fal' ? 'fal TTS' : 'ElevenLabs TTS' %>)</button>
    </form>
    <p style="color:#5b6b73">This page polls the server every 5s. <strong>LIVE</strong> means heartbeats are fresh. <strong>DEAD</strong> means the process stopped (503/redeploy) even if an old job line still says running.</p>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/reset-stuck-audio" style="margin-top:8px" id="resetAudioForm">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn btn-secondary" type="submit" id="resetAudioBtn">Reset stuck audio → script_ready</button>
    </form>
    <p>Weekly draft no longer auto-runs TTS. Generate preview from this page after the full script is ready. Requires <code>PODCASTS_GENERATION_ENABLED=true</code> plus <code>ELEVENLABS_API_KEY</code> (default) or fal fallback via <code>PODCASTS_TTS_PROVIDER=fal</code>.</p>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/upload-audio" enctype="multipart/form-data">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <label>Upload replacement MP3 <input type="file" name="audio" accept="audio/mpeg,.mp3" required></label>
      <button class="btn btn-secondary" type="submit">Upload audio</button>
    </form>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/clean-recording" enctype="multipart/form-data" style="margin-top:16px;padding:16px;border:1px solid #d5dde2;border-radius:8px;background:#f7fafb">
      <h3 style="margin-top:0">Record yourself → AI cleanup</h3>
      <p style="margin:0 0 12px;color:#3d4a52">Upload your phone or mic take (M4A, WAV, MP3, etc.). ElevenLabs Voice Isolator removes room noise and keeps <strong>your real voice</strong> — it does not clone or replace it. Then we encode the master and optionally prepend the announcer intro.</p>
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <label style="display:block;margin-bottom:8px">Your Geno recording <input type="file" name="recording" accept="audio/*,video/mp4,video/quicktime,.m4a,.mp3,.wav,.aac,.flac,.ogg,.mp4,.mov,.webm" required></label>
      <input type="hidden" name="prepend_intro" value="0">
      <label style="display:block;margin-bottom:12px">
        <input type="checkbox" name="prepend_intro" value="1" checked>
        Prepend announcer intro bumper
      </label>
      <button class="btn" type="submit" <%= cfg.elevenApiKey ? '' : 'disabled' %>>Clean recording &amp; set as preview</button>
      <% if (!cfg.elevenApiKey) { %><p style="color:#8a3b12;margin:8px 0 0">Needs <code>ELEVENLABS_API_KEY</code> on the server.</p><% } %>
    </form>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/upload-artwork" enctype="multipart/form-data">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <label>Upload episode artwork <input type="file" name="artwork" accept="image/jpeg,image/png,image/webp" required></label>
      <button class="btn btn-secondary" type="submit">Upload artwork</button>
    </form>
    <h3>Generation jobs</h3>
    <ul class="jobs">
      <% if (!jobs.length) { %><li>No jobs yet.</li><% } %>
      <% jobs.forEach(job => { %>
        <li>#<%= job.attempt %> <%= job.status %> section <%= job.section_index + 1 %>/<%= job.section_count %><% if (job.error_detail) { %> — <%= job.error_detail %><% } %></li>
      <% }) %>
    </ul>
  </section>

  <section class="card">
    <h2>Approval &amp; publishing</h2>
    <p>Nothing publishes automatically. Approve finished audio, optionally schedule, then Publish to the website and RSS.</p>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/approve" style="display:inline">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn" type="submit">Approve audio</button>
    </form>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/schedule" style="display:inline-block">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <label>Schedule approved episode for <input type="datetime-local" name="scheduled_for" required></label>
      <button class="btn btn-secondary" type="submit">Mark scheduled</button>
    </form>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/publish" style="display:inline">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn" type="submit">Publish now</button>
    </form>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/unpublish" style="display:inline">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn btn-secondary" type="submit">Unpublish</button>
    </form>
    <% if (episode.status === 'published') { %>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-retry" style="display:inline">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn btn-secondary" type="submit">Regenerate YouTube stills</button>
    </form>
    <% } %>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/reject-regenerate" style="margin-top:16px" onsubmit="return confirm('Reject this draft and generate a new weekly attempt?');">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn btn-secondary" type="submit">Reject and regenerate draft</button>
    </form>
  </section>

  <% if (episode.status === 'published') { %>
  <% const stills = typeof youtubeStills !== 'undefined' && youtubeStills ? youtubeStills : { status: 'idle', items: [], last_error: null, youtube_url: null }; %>
  <% const stillsSummary = typeof youtubeStillsSummary !== 'undefined' && youtubeStillsSummary ? youtubeStillsSummary : { total: 0, approved: 0, ready: 0, rejected: 0, failed: 0, pending: 0, regenerating: 0, allApproved: false }; %>
  <% const ytProgress = typeof youtubeProgress !== 'undefined' && youtubeProgress ? youtubeProgress : { state: 'idle', label: 'YouTube pipeline idle', detail: '', percent: 0, phase: 'idle' }; %>
  <section class="card" id="youtube-stills-review">
    <h2>YouTube stills review</h2>
    <div id="youtubeStatusPanel" class="yt-<%= ytProgress.state || 'idle' %>" data-episode-id="<%= episode.id %>" data-board-status="<%= stills.status || 'idle' %>">
      <strong id="youtubeStatusLabel"><%= ytProgress.label || 'YouTube status unknown' %></strong>
      <div class="yt-meter <%= ytProgress.live ? 'yt-meter-live' : '' %> <%= ytProgress.state === 'failed' ? 'yt-meter-failed' : '' %>" id="youtubeMeter">
        <span id="youtubeMeterFill" style="width:<%= Math.max(0, Math.min(100, Number(ytProgress.percent) || 0)) %>%"></span>
      </div>
      <p id="youtubeStatusDetail" style="margin:0 0 6px"><%= ytProgress.detail || '' %></p>
      <p class="yt-meta" style="margin:0">
        Phase: <code id="youtubePhase"><%= ytProgress.phase || 'idle' %></code>
        · Board: <span class="status" id="youtubeBoardStatus"><%= stills.status || 'idle' %></span>
        · Approved: <span id="youtubeApprovedCount"><%= stillsSummary.approved || 0 %></span>/<span id="youtubeTotalCount"><%= stillsSummary.total || 0 %></span>
        · Meter: <span id="youtubePercentLabel"><%= Math.max(0, Math.min(100, Number(ytProgress.percent) || 0)) %>%</span>
        <% if (stills.youtube_url || ytProgress.youtube_url) { %>
          · <a id="youtubeStatusLink" href="<%= stills.youtube_url || ytProgress.youtube_url %>" target="_blank" rel="noopener">Open on YouTube</a>
        <% } else { %>
          · <a id="youtubeStatusLink" href="#" target="_blank" rel="noopener" style="display:none">Open on YouTube</a>
        <% } %>
      </p>
    </div>
    <p>
      After the podcast is published, story images are generated here first.
      Approve the ones that look right. Check one or more stills and use <strong>Regenerate selected</strong> to redo several at once (optional shared direction).
      Or reject a single still with its own note. The YouTube video is created <strong>only after every still is approved</strong>.
    </p>
    <p>
      Board status: <span class="status"><%= stills.status || 'idle' %></span>
      · <%= stillsSummary.approved || 0 %>/<%= stillsSummary.total || 0 %> approved
      <% if (stillsSummary.ready) { %> · <%= stillsSummary.ready %> ready<% } %>
      <% if (stillsSummary.failed) { %> · <%= stillsSummary.failed %> failed<% } %>
      <% if (stillsSummary.regenerating) { %> · <%= stillsSummary.regenerating %> regenerating<% } %>
    </p>
    <% if (stills.last_error) { %>
      <p class="error"><strong>Stills error:</strong> <%= stills.last_error %></p>
    <% } %>
    <% if (stills.youtube_url) { %>
      <p class="notice">YouTube video: <a href="<%= stills.youtube_url %>" target="_blank" rel="noopener"><%= stills.youtube_url %></a></p>
    <% } %>

    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-stills/prepare" style="display:inline">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn" type="submit"><%= stills.items && stills.items.length ? 'Refresh stills' : 'Generate stills for review' %></button>
    </form>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-stills/prepare" style="display:inline">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <input type="hidden" name="force" value="true">
      <button class="btn btn-secondary" type="submit">Force regenerate all stills</button>
    </form>
    <% if (stillsSummary.ready > 0 || stillsSummary.approved > 0) { %>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-stills/approve-all" style="display:inline" onsubmit="return confirm('Approve every usable still?');">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn" type="submit">Approve all</button>
    </form>
    <% } %>
    <% if (stillsSummary.allApproved) { %>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-stills/create-video" style="display:inline" onsubmit="return confirm('Create and upload the YouTube video from the approved stills?');">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn" type="submit">Create YouTube video</button>
    </form>
    <% } else if (stills.items && stills.items.length) { %>
      <p class="notice">Create YouTube video stays locked until every still below is approved.</p>
    <% } %>
    <% if (stills.youtube_url) { %>
    <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-stills/update-description" style="display:inline" onsubmit="return confirm('Update the live YouTube description with Florida Buzz link first + episode links?');">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="btn btn-secondary" type="submit">Refresh YouTube description</button>
    </form>
    <% } %>

    <% if (!stills.items || !stills.items.length) { %>
      <p class="notice" style="margin-top:16px">
        <% if (stills.status === 'generating') { %>
          Generating stills — refresh this page in a minute or two.
        <% } else { %>
          No stills yet. Click <strong>Generate stills for review</strong> (or publish queues this automatically).
        <% } %>
      </p>
    <% } else { %>
      <% const regenerableStills = stills.items.filter(function (item) { return item.status !== 'regenerating' && item.status !== 'generating'; }); %>
      <form id="bulk-regenerate-stills" method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-stills/reject-bulk" style="display:none" aria-hidden="true">
        <input type="hidden" name="csrf" value="<%= csrf %>">
      </form>
      <div class="still-bulk-bar" id="stillBulkBar">
        <label class="inline">
          <input type="checkbox" id="stillSelectAll" <%= regenerableStills.length ? '' : 'disabled' %>>
          Select all
        </label>
        <span id="stillSelectedCount" style="font-size:14px;color:#4a5350">0 selected</span>
        <label class="bulk-note" style="font-size:13px">Shared direction for selected (optional)
          <textarea form="bulk-regenerate-stills" name="note" rows="2" placeholder="e.g. Cooler daylight, no cars, lake-side angle"></textarea>
        </label>
        <button class="btn btn-secondary" type="submit" form="bulk-regenerate-stills" id="stillBulkSubmit" disabled>Regenerate selected</button>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-top:12px">
        <% stills.items.forEach(function (item) { %>
          <% const canSelect = item.status !== 'regenerating' && item.status !== 'generating'; %>
          <article class="still-card" data-still-id="<%= item.id %>">
            <% if (canSelect) { %>
            <label class="still-select">
              <input type="checkbox" class="still-bulk-check" form="bulk-regenerate-stills" name="still_ids" value="<%= item.id %>">
              Select
            </label>
            <% } %>
            <p style="margin:0 0 8px;font-size:13px;padding-left:<%= canSelect ? '88px' : '0' %>">
              <span class="status"><%= item.status %></span>
              · <%= item.label || item.id %>
              <% if (item.source) { %> · <code><%= item.source %></code><% } %>
            </p>
            <% if (item.public_url) { %>
              <a href="<%= item.public_url %>" target="_blank" rel="noopener">
                <img src="<%= item.public_url %><%= item.public_url.indexOf('?') >= 0 ? '&' : '?' %>v=<%= encodeURIComponent((stills && stills.updated_at) || item.storage_path || item.id) %>" alt="<%= item.label || 'YouTube still' %>" style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:#ddd">
              </a>
            <% } else { %>
              <div style="width:100%;aspect-ratio:16/9;background:#e8eef0;display:flex;align-items:center;justify-content:center;color:#5a6a70;font-size:14px">
                <%= item.status === 'regenerating' || item.status === 'generating' ? 'Generating…' : 'No image yet' %>
              </div>
            <% } %>
            <% if (item.error) { %>
              <p class="error" style="margin:8px 0 0;font-size:13px"><%= item.error %></p>
            <% } %>
            <% if (item.rejection_note) { %>
              <p style="margin:8px 0 0;font-size:13px"><strong>Direction:</strong> <%= item.rejection_note %></p>
            <% } %>
            <% if (item.reference_credit) { %>
              <p style="margin:8px 0 0;font-size:12px;color:#5a6a70">Photo ref: <%= item.reference_credit %></p>
            <% } %>
            <div style="margin-top:10px">
              <% if (item.public_url && item.status !== 'approved') { %>
              <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-stills/<%= encodeURIComponent(item.id) %>/approve" style="display:inline">
                <input type="hidden" name="csrf" value="<%= csrf %>">
                <button class="btn" type="submit">Approve</button>
              </form>
              <% } %>
              <% if (canSelect) { %>
              <form method="post" action="/admin/podcasts/episodes/<%= episode.id %>/youtube-stills/<%= encodeURIComponent(item.id) %>/reject" style="margin-top:8px">
                <input type="hidden" name="csrf" value="<%= csrf %>">
                <label style="font-size:13px">Reject &amp; redo — optional direction
                  <textarea name="note" rows="2" placeholder="e.g. Show the BoardWalk from the lake side, no cars, cooler daylight"><%= item.rejection_note || '' %></textarea>
                </label>
                <button class="btn btn-secondary" type="submit">Reject &amp; regenerate</button>
              </form>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
    <% if (stills.status === 'generating' || stills.status === 'building_video' || (stillsSummary.regenerating || 0) > 0) { %>
      <p class="notice" style="margin-top:16px">Status meter updates automatically while YouTube work is running…</p>
    <% } %>
  </section>
  <% } %>
  <script>
    (function () {
      var form = document.getElementById('bulk-regenerate-stills');
      var selectAll = document.getElementById('stillSelectAll');
      var countEl = document.getElementById('stillSelectedCount');
      var submitBtn = document.getElementById('stillBulkSubmit');
      if (!form || !submitBtn) return;
      function checks() {
        return Array.prototype.slice.call(document.querySelectorAll('.still-bulk-check'));
      }
      function syncBulkUi() {
        var boxes = checks();
        var selected = boxes.filter(function (el) { return el.checked; });
        if (countEl) countEl.textContent = selected.length + ' selected';
        submitBtn.disabled = selected.length === 0;
        boxes.forEach(function (el) {
          var card = el.closest('.still-card');
          if (card) card.classList.toggle('selected', el.checked);
        });
        if (selectAll) {
          selectAll.checked = boxes.length > 0 && selected.length === boxes.length;
          selectAll.indeterminate = selected.length > 0 && selected.length < boxes.length;
        }
      }
      document.addEventListener('change', function (e) {
        if (e.target && (e.target.classList.contains('still-bulk-check') || e.target.id === 'stillSelectAll')) {
          if (e.target.id === 'stillSelectAll') {
            checks().forEach(function (el) { el.checked = selectAll.checked; });
          }
          syncBulkUi();
        }
      });
      form.addEventListener('submit', function (e) {
        if (!checks().some(function (el) { return el.checked; })) {
          e.preventDefault();
          alert('Select at least one still to regenerate.');
        }
      });
      syncBulkUi();
    })();
    (function () {
      var ytPanel = document.getElementById('youtubeStatusPanel');
      if (ytPanel) {
        var ytEpisodeId = ytPanel.getAttribute('data-episode-id');
        var ytStates = ['live', 'stalled', 'failed', 'done', 'ready', 'uncertain', 'idle'];
        var lastBoardStatus = ytPanel.getAttribute('data-board-status') || '';
        var lastPhase = '';
        function applyYoutube(data) {
          var p = data.progress || {};
          var summary = data.summary || p.summary || {};
          ytStates.forEach(function (s) { ytPanel.classList.remove('yt-' + s); });
          ytPanel.classList.add('yt-' + (p.state || 'idle'));
          var labelEl = document.getElementById('youtubeStatusLabel');
          var detailEl = document.getElementById('youtubeStatusDetail');
          var phaseEl = document.getElementById('youtubePhase');
          var boardEl = document.getElementById('youtubeBoardStatus');
          var approvedEl = document.getElementById('youtubeApprovedCount');
          var totalEl = document.getElementById('youtubeTotalCount');
          var pctEl = document.getElementById('youtubePercentLabel');
          var fillEl = document.getElementById('youtubeMeterFill');
          var meterEl = document.getElementById('youtubeMeter');
          var linkEl = document.getElementById('youtubeStatusLink');
          if (labelEl) labelEl.textContent = p.label || 'YouTube status unknown';
          if (detailEl) {
            detailEl.textContent = p.detail || '';
            if (p.youtube_url && p.phase === 'video_published') {
              detailEl.innerHTML = '<a href="' + p.youtube_url + '" target="_blank" rel="noopener">' + p.youtube_url + '</a>';
            }
          }
          if (phaseEl) phaseEl.textContent = p.phase || 'idle';
          if (boardEl) boardEl.textContent = data.board_status || p.phase || 'idle';
          if (approvedEl) approvedEl.textContent = summary.approved != null ? summary.approved : '0';
          if (totalEl) totalEl.textContent = summary.total != null ? summary.total : '0';
          var pct = Math.max(0, Math.min(100, Number(p.percent) || 0));
          if (pctEl) pctEl.textContent = pct + '%';
          if (fillEl) fillEl.style.width = pct + '%';
          if (meterEl) {
            meterEl.classList.toggle('yt-meter-live', !!p.live);
            meterEl.classList.toggle('yt-meter-failed', p.state === 'failed');
          }
          if (linkEl) {
            if (p.youtube_url || data.youtube_url) {
              linkEl.href = p.youtube_url || data.youtube_url;
              linkEl.style.display = '';
            } else {
              linkEl.style.display = 'none';
            }
          }
          var boardStatus = data.board_status || '';
          var phase = p.phase || '';
          // Reload when stills finish generating or video finishes so cards/buttons refresh.
          if (
            (lastBoardStatus === 'generating' && boardStatus === 'ready_for_review')
            || (lastPhase === 'building_video' && phase === 'video_published')
            || (lastPhase === 'regenerating' && phase === 'ready_for_review')
          ) {
            window.location.reload();
            return;
          }
          lastBoardStatus = boardStatus;
          lastPhase = phase;
        }
        async function pollYoutube() {
          try {
            var res = await fetch('/admin/podcasts/episodes/' + ytEpisodeId + '/youtube-status', {
              credentials: 'same-origin',
              headers: { Accept: 'application/json' },
              cache: 'no-store',
            });
            if (!res.ok) return;
            applyYoutube(await res.json());
          } catch (e) { /* keep last known status */ }
        }
        pollYoutube();
        setInterval(pollYoutube, 5000);
      }
    })();
    (function () {
      var panel = document.getElementById('audioStatusPanel');
      if (!panel) return;
      var episodeId = panel.getAttribute('data-episode-id');
      var labelEl = document.getElementById('audioStatusLabel');
      var detailEl = document.getElementById('audioStatusDetail');
      var statusEl = document.getElementById('audioEpisodeStatus');
      var sectionEl = document.getElementById('audioSectionLabel');
      var ageEl = document.getElementById('audioHeartbeatAge');
      var genBtn = document.getElementById('generateAudioBtn');
      var states = ['live', 'stalled', 'failed', 'done', 'uncertain', 'idle'];

      function apply(data) {
        var p = data.progress || {};
        states.forEach(function (s) { panel.classList.remove('audio-' + s); });
        panel.classList.add('audio-' + (p.state || 'idle'));
        if (labelEl) labelEl.textContent = p.label || 'Status unknown';
        if (detailEl) detailEl.textContent = p.detail || '';
        if (statusEl) statusEl.textContent = data.episode_status || '';
        if (sectionEl) sectionEl.textContent = p.sectionLabel || 'no active section';
        if (ageEl) {
          ageEl.textContent = p.ageMs == null ? 'n/a' : Math.round(p.ageMs / 1000) + 's';
        }
        if (genBtn) {
          genBtn.disabled = p.state === 'live' || <%= cfg.generation ? 'false' : 'true' %>;
        }
        if (p.state === 'done' && data.audio_url && !document.getElementById('episodeAudio')) {
          window.location.reload();
        }
      }

      async function poll() {
        try {
          var res = await fetch('/admin/podcasts/episodes/' + episodeId + '/audio-status', {
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
            cache: 'no-store',
          });
          if (!res.ok) return;
          apply(await res.json());
        } catch (e) { /* keep last known status */ }
      }

      poll();
      setInterval(poll, 5000);

      var scriptForm = document.querySelector('form[data-long-job="script"]');
      if (scriptForm) {
        scriptForm.addEventListener('submit', function () {
          if (detailEl) detailEl.textContent = 'Generating full script with OpenAI — keep this tab open…';
        });
      }
    })();
  </script>
</body>
</html>
