<%- include('partials/header', { pageTitle: typeof pageTitle !== 'undefined' ? pageTitle : 'Podcasts — The Florida Buzz', category: null, tickerItems: [], canonicalPath: '/podcasts', isPodcastsPage: true }) %>
<link rel="stylesheet" href="/css/podcasts.css">

<main class="wrap podcast-page">
  <header class="podcast-hero">
    <p class="podcast-eyebrow">The Florida Buzz Podcasts</p>
    <h1>Listen in</h1>
    <p class="podcast-lede">Original Florida Buzz audio hosted by Geno — park news, planning tips, and Sunshine State stories, separate from our written guides.</p>
  </header>

  <% if (!cards || !cards.length) { %>
    <p class="podcast-empty">No podcasts are listed yet. Check back soon.</p>
  <% } else { %>
    <div class="podcast-directory">
      <% cards.forEach(card => { %>
        <article class="podcast-card">
          <a class="podcast-card-art" href="/podcasts/<%= card.show.slug %>">
            <img src="<%= card.show.cover_url || '/img/podcasts/florida-buzz-disney-cover.jpg' %>" alt="<%= card.show.cover_alt || (card.show.title + ' cover art') %>" width="400" height="400" loading="lazy">
          </a>
          <div class="podcast-card-body">
            <h2><a href="/podcasts/<%= card.show.slug %>"><%= card.show.title %></a></h2>
            <p class="podcast-hosts">
              Hosts:
              <%= (card.show.hosts || []).map(h => h.name).join(' & ') || 'TBA' %>
            </p>
            <p><%= card.show.description %></p>
            <p class="podcast-disclosure"><%= card.show.disclosure %></p>
            <% if (card.latest && card.latest.audio_url) { %>
              <p class="podcast-latest-label">Latest episode<% if (card.episodeCount > 1) { %> · <%= card.episodeCount %> published<% } %></p>
              <p class="podcast-latest-title"><a href="/podcasts/<%= card.show.slug %>/<%= card.latest.slug %>"><%= card.latest.title %></a></p>
              <%- include('partials/podcast-player', { audioUrl: card.latest.audio_url }) %>
            <% } else { %>
              <p class="podcast-empty">No published episodes yet.</p>
            <% } %>

            <% if (card.recent && card.recent.length > 1) { %>
              <div class="podcast-directory-archive">
                <p class="podcast-latest-label">Episode archive</p>
                <ul>
                  <% card.recent.forEach(ep => { %>
                    <li>
                      <a href="/podcasts/<%= card.show.slug %>/<%= ep.slug %>"><%= ep.title %></a>
                      <% if (ep.published_at) { %>
                        <span class="podcast-meta"><%= new Date(ep.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                      <% } %>
                    </li>
                  <% }) %>
                </ul>
                <% if (card.episodeCount > card.recent.length) { %>
                  <p class="podcast-meta"><a href="/podcasts/<%= card.show.slug %>">See all <%= card.episodeCount %> episodes →</a></p>
                <% } %>
              </div>
            <% } %>

            <p class="podcast-links">
              <a class="btn" href="/podcasts/<%= card.show.slug %>">Show page &amp; full archive</a>
              <a class="btn btn-outline" href="/podcasts/<%= card.show.slug %>/rss.xml">RSS feed</a>
            </p>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>

  <section class="podcast-future">
    <h2>More Florida Buzz shows</h2>
    <p>This directory has room for additional Florida Buzz podcasts as they launch. Florida Buzz: Disney is the first show.</p>
  </section>
</main>

<%- include('partials/footer') %>
