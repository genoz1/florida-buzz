<%- include('partials/header', {
  pageTitle: (query ? ('Search: ' + query + ' — ') : '') + 'The Florida Buzz',
  pageDescription: query
    ? ('Florida Buzz stories and guides matching “' + query + '”.')
    : 'Search Florida Buzz stories and guides by topic, park, beach, cruise, or place.',
  category: typeof category !== 'undefined' ? category : null,
  tickerItems: [],
  canonicalPath: '/search',
  robots: query ? 'noindex,follow' : 'max-image-preview:large',
  isSearchPage: true,
  searchQuery: query || ''
}) %>

<main class="wrap">
  <section class="section search-hero" style="border-bottom:none; padding-bottom:0;">
    <span class="eyebrow">Search</span>
    <h1 style="font-family:var(--font-display); font-size:34px; color:var(--teal-900); margin:8px 0 0;">Find a Florida Buzz story</h1>
    <p style="color:var(--ink-600); max-width:640px; margin-top:10px;">
      Search titles and summaries across news and guides — theme parks, beaches, space, cruises, wildlife, and more.
    </p>
    <form class="search-page-form" action="/search" method="get" role="search">
      <label class="visually-hidden" for="searchPageInput">Search stories</label>
      <input
        id="searchPageInput"
        class="search-page-input"
        type="search"
        name="q"
        value="<%= query || '' %>"
        placeholder="Try Epic Universe, manatee, Port Canaveral…"
        maxlength="80"
        autocomplete="off"
        autofocus
      >
      <button type="submit" class="search-page-submit">Search</button>
    </form>
  </section>

  <section class="section">
    <% if (!query) { %>
      <p style="color:var(--ink-600);">Type a topic above, or browse by category from the News bar.</p>
    <% } else if (!articles.length) { %>
      <p style="color:var(--ink-600);">
        No stories matched <strong><%= query %></strong>.
        Try a shorter phrase, a park or place name, or browse
        <a href="/guides" style="color:var(--coral-600); font-weight:600;">guides</a>
        and
        <a href="/" style="color:var(--coral-600); font-weight:600;">today’s news</a>.
      </p>
    <% } else { %>
      <p class="search-result-count" style="color:var(--ink-600); margin-bottom:18px;">
        <%= pagination && pagination.total ? pagination.total : articles.length %>
        result<%= (pagination && pagination.total ? pagination.total : articles.length) === 1 ? '' : 's' %>
        for <strong><%= query %></strong>
      </p>
      <div class="grid">
        <% articles.forEach(a => { %>
          <a href="/article/<%= a.slug %>" class="card">
            <div class="card-image"><img src="<%= thumbUrl(a.image_url) || placeholderImg(a.category) %>" alt="<%= a.title %>" width="480" height="300" loading="lazy" onerror="this.onerror=null;this.src='<%= placeholderImg(a.category) %>';"></div>
            <p class="byline" style="margin-bottom:6px;"><%= categoryLabels[a.category] || a.category %><% if (a.is_evergreen) { %> · Guide<% } %></p>
            <h3><%= a.title %></h3>
            <p class="dek-sm"><%= a.dek %></p>
            <p class="byline"><%= timeAgo(a.published_at) %></p>
          </a>
        <% }) %>
      </div>
      <% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
      <nav class="archive-pagination" aria-label="Search result pages" style="margin-top:28px; display:flex; gap:16px; flex-wrap:wrap; align-items:center;">
        <% if (pagination.prevHref) { %><a href="<%= pagination.prevHref %>" rel="prev">← Previous</a><% } %>
        <span style="color:var(--ink-600); font-size:14px;">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
        <% if (pagination.nextHref) { %><a href="<%= pagination.nextHref %>" rel="next">Next →</a><% } %>
      </nav>
      <% } %>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>
