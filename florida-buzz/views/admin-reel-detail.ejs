<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Florida Buzz Reel package</title><style>body{max-width:900px;margin:30px auto;padding:20px;font:16px system-ui;color:#182a34}video{max-width:360px;width:100%;max-height:640px}pre{white-space:pre-wrap;background:#eef5f6;padding:16px}button{padding:12px 24px;margin-right:12px}section{border-top:1px solid #ddd;margin-top:24px;padding-top:20px}a{color:#00697b}</style></head><body>
<a href="/admin/reels">All packages</a><h1><%= pkg.data.guide?.title || pkg.topic_key %></h1><p>Status: <strong><%= pkg.status %></strong></p>
<% if(pkg.data.guide){ %><p><a href="<%= pkg.data.guide.url %>" rel="noopener"><%= pkg.data.guide.url %></a> · <%= pkg.data.guide.handling %></p><% } %>
<p><%= pkg.data.warning || '' %></p><p>Actual fal cost: <%= pkg.data.actualCost === undefined ? 'Pending reconciliation' : '$'+pkg.data.actualCost.toFixed(4) %>. Remaining balance after generation: <%= pkg.data.balanceAfter === undefined ? 'Pending' : '$'+pkg.data.balanceAfter.toFixed(4) %>.</p>
<% if(pkg.data.script){ %><h2>Hook</h2><p><%= pkg.data.script.hook %></p><h2>Narration</h2><% for(const thought of pkg.data.script.thoughts){ %><p><%= thought %></p><% } %><% } %>
<% if(pkg.data.narrationTiming){ %><p>Native speed 1.0× · narration <%= pkg.data.narrationTiming.duration.toFixed(2) %> seconds · intentional pauses 0.4 / 0.4 / 0.7 seconds.</p><% } %>
<% for(const a of assets){ %><section><h2><%= a.label %></h2><% if(a.path.endsWith('.mp4')){ %><video controls preload="metadata" src="<%= a.url %>"></video><% }else{ %><audio controls preload="metadata" src="<%= a.url %>"></audio><% } %><p><a href="<%= a.url %>" download>Download original file</a></p><% if(a.review){ %><p>Review: <%= a.review.classification %>. <%= a.review.issues.join('; ') %>. Charge: <%= a.actual===null?'Pending':'$'+Number(a.actual).toFixed(4) %></p><% } %></section><% } %>
<% if(pkg.data.social){ %><h2>Prepared social copy — unpublished</h2><% for(const [name,copy] of Object.entries(pkg.data.social)){ %><h3><%= name %></h3><pre><%= typeof copy==='string'?copy:JSON.stringify(copy,null,2) %></pre><% } %><% } %>
<h2>Source verification</h2><pre><%= JSON.stringify(pkg.data.facts || {},null,2) %></pre>
<% if(pkg.status==='READY_FOR_APPROVAL'){ %><p>Watch the entire finished Reel, confirm location and human motion, and check facts/captions before approval.</p><form method="post" action="/admin/reels/<%= pkg.id %>/decision"><input type="hidden" name="csrf" value="<%= csrf %>"><button name="action" value="APPROVED">Approve</button><button name="action" value="REJECTED">Reject</button></form><% } %>
<p>Approval and rejection never call a social publisher.</p></body></html>
