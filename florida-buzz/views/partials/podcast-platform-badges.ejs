<%#
  Compact listen-on badges for Apple Podcasts / Spotify / YouTube.
  Expects: links = [{ platform, url, sort_order? }, ...]
%>
<% if (links && links.length) { %>
  <%
    const platformKey = (name) => {
      const n = String(name || '').toLowerCase();
      if (n.includes('apple')) return 'apple';
      if (n.includes('spotify')) return 'spotify';
      if (n.includes('youtube')) return 'youtube';
      return 'other';
    };
    const sorted = links.slice().sort((a, b) => (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0));
  %>
  <nav class="podcast-platform-badges" aria-label="Listen on">
    <span class="podcast-platform-label">Listen on</span>
    <ul>
      <% sorted.forEach((link) => {
        const key = platformKey(link.platform);
        const label = link.platform || 'Podcast';
      %>
        <li>
          <a class="podcast-platform-badge podcast-platform-<%= key %>"
             href="<%= link.url %>"
             target="_blank"
             rel="noopener noreferrer"
             aria-label="<%= label %>">
            <% if (key === 'apple') { %>
              <svg class="podcast-platform-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M18.71 12.2c-.03-2.4 1.96-3.55 2.05-3.6-1.12-1.63-2.86-1.86-3.48-1.88-1.48-.15-2.89.87-3.64.87-.75 0-1.91-.85-3.14-.83-1.62.02-3.11.94-3.94 2.39-1.68 2.92-.43 7.24 1.21 9.61.8 1.16 1.76 2.46 3.02 2.41 1.21-.05 1.67-.78 3.13-.78 1.46 0 1.87.78 3.14.76 1.3-.02 2.12-1.18 2.91-2.35.92-1.34 1.3-2.64 1.32-2.71-.03-.01-2.53-.97-2.56-3.84zM15.6 4.9c.67-.81 1.12-1.93.99-3.05-1 .04-2.2.66-2.91 1.48-.64.73-1.2 1.9-1.05 3.02 1.11.09 2.25-.56 2.97-1.45z"/>
              </svg>
            <% } else if (key === 'spotify') { %>
              <svg class="podcast-platform-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.52 17.34c-.24.36-.66.48-1.02.24-2.82-1.74-6.36-2.1-10.56-1.14-.42.12-.78-.18-.9-.54-.12-.42.18-.78.54-.9 4.56-1.02 8.52-.6 11.64 1.32.42.18.48.66.3 1.02zm1.44-3.18c-.3.42-.84.6-1.26.3-3.24-1.98-8.16-2.58-11.94-1.38-.48.12-.96-.18-1.08-.66-.12-.48.18-.96.66-1.08 4.38-1.32 9.78-.66 13.5 1.62.42.24.54.84.12 1.2zm.12-3.3C15.24 8.4 8.82 8.16 5.16 9.3c-.6.18-1.2-.18-1.38-.72-.18-.6.18-1.2.72-1.38 4.26-1.26 11.28-1.02 15.72 1.62.54.3.72 1.02.42 1.56-.3.48-1.02.66-1.56.36z"/>
              </svg>
            <% } else if (key === 'youtube') { %>
              <svg class="podcast-platform-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8zM9.75 15.5v-7l6.5 3.5-6.5 3.5z"/>
              </svg>
            <% } else { %>
              <span class="podcast-platform-dot" aria-hidden="true"></span>
            <% } %>
            <span class="podcast-platform-name"><%= label %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </nav>
<% } %>
