<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'The Florida Buzz' %></title>
  <meta name="description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'Florida theme parks, beaches, space launches, wildlife, and travel — sourced straight from the official channels.' %>">
  <meta name="robots" content="<%= typeof robots !== 'undefined' ? robots : 'max-image-preview:large' %>">
  <link rel="canonical" href="<%= typeof canonicalOverride !== 'undefined' && canonicalOverride ? canonicalOverride : (process.env.SITE_URL || 'https://thefloridabuzz.com') + (typeof canonicalPath !== 'undefined' && canonicalPath ? canonicalPath : '') %>">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="The Florida Buzz" href="<%= (process.env.SITE_URL || 'https://thefloridabuzz.com') %>/feed.xml">

  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle : 'The Florida Buzz' %>">
  <meta property="og:description" content="<%= typeof pageDescription !== 'undefined' ? pageDescription : 'Florida theme parks, beaches, space launches, wildlife, and travel — sourced straight from the official channels.' %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <% if (typeof pageImage !== 'undefined' && pageImage) { %><meta property="og:image" content="<%= pageImage %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">

  <% if (process.env.GA4_MEASUREMENT_ID) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= process.env.GA4_MEASUREMENT_ID %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= process.env.GA4_MEASUREMENT_ID %>');
  </script>
  <% } %>

  <% if (process.env.ADSENSE_CLIENT_ID) { %>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= process.env.ADSENSE_CLIENT_ID %>" crossorigin="anonymous"></script>
  <% } %>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Loaded asynchronously (preload, then swap to stylesheet on load) instead
       of a plain blocking <link rel="stylesheet">, which was forcing the
       browser to wait on an external domain before it could render anything
       — flagged directly by PageSpeed Insights as the single biggest
       remaining "render-blocking requests" issue (2,240ms). The noscript
       fallback keeps fonts working correctly with JS disabled. -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=Source+Sans+3:wght@400;600;700&family=JetBrains+Mono:wght@500;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;1,500&family=Source+Sans+3:wght@400;600;700&family=JetBrains+Mono:wght@500;700&display=swap"></noscript>
  <link rel="stylesheet" href="/css/style.css?v=20261109-sitewide-compact-nav">
  <!-- Soften AI amber/golden washes on article card + hero photos (display only). -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <filter id="fb-cool-yellow" color-interpolation-filters="sRGB">
      <feColorMatrix type="matrix" values="
        0.90 0.00 0.00 0 0.02
        0.00 0.92 0.00 0 0.01
        0.06 0.06 1.05 0 0
        0    0    0    1 0"/>
    </filter>
  </svg>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsMediaOrganization",
    "name": "Florida Buzz",
    "url": "<%= (process.env.SITE_URL || 'https://thefloridabuzz.com') %>",
    "logo": "<%= (process.env.SITE_URL || 'https://thefloridabuzz.com') %>/images/florida-buzz-mark.svg",
    "masthead": "<%= (process.env.SITE_URL || 'https://thefloridabuzz.com') %>/about",
    "ethicsPolicy": "<%= (process.env.SITE_URL || 'https://thefloridabuzz.com') %>/editorial-standards",
    "correctionsPolicy": "<%= (process.env.SITE_URL || 'https://thefloridabuzz.com') %>/corrections-policy"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Florida Buzz",
    "url": "<%= (process.env.SITE_URL || 'https://thefloridabuzz.com') %>",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= (process.env.SITE_URL || 'https://thefloridabuzz.com') %>/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }<% if (typeof socialProfiles !== 'undefined' && socialProfiles && socialProfiles.length) { %>,
    "sameAs": <%- JSON.stringify(socialProfiles.map(function (p) { return p.href; })) %>
    <% } %>
  }
  </script>
</head>
<body>

  <div class="utility-bar utility-bar-compact">
    <div class="wrap">
      <span>Your daily dose of Florida</span>
      <a href="/#newsletter">Get the daily roundup &rarr;</a>
    </div>
  </div>

  <nav class="nav nav-compact" aria-label="Site">
    <div class="wrap nav-primary">
      <%# ™ is correct while the federal registration is pending. Do not use ® until the mark is registered. %>
      <a href="/" class="logo" title="Florida Buzz trademark" aria-label="Florida Buzz home">
        <img class="logo-mark" src="/images/florida-buzz-mark.svg" width="34" height="34" alt="" decoding="async">
        <span class="logo-wordmark">Florida <em>Buzz</em><span class="tm" aria-hidden="true">™</span></span>
      </a>
      <div class="nav-links nav-links-primary" aria-label="Primary">
        <a href="/category/theme-parks" class="nav-link-emphasis <%= typeof category !== 'undefined' && category === 'theme-parks' ? 'active' : '' %>">Theme Parks</a>
        <a href="/guides" class="<%= typeof isGuidesPage !== 'undefined' && isGuidesPage ? 'active' : '' %>">Guides</a>
        <a href="/podcasts" class="<%= typeof isPodcastsPage !== 'undefined' && isPodcastsPage ? 'active' : '' %>">Podcasts</a>
        <a href="/#explore-florida">Explore Florida</a>
        <a href="/merch" class="<%= typeof isMerchPage !== 'undefined' && isMerchPage ? 'active' : '' %>">Merch</a>
        <a href="/sponsors" class="<%= typeof isSponsorsPage !== 'undefined' && isSponsorsPage ? 'active' : '' %>">Sponsorships</a>
      </div>
      <form class="nav-search nav-search-icon" action="/search" method="get" role="search">
        <label class="visually-hidden" for="navSearchInput">Search stories</label>
        <input
          id="navSearchInput"
          class="nav-search-input"
          type="search"
          name="q"
          value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>"
          placeholder="Search stories"
          maxlength="80"
          autocomplete="off"
        >
        <button type="submit" class="nav-search-submit" aria-label="Search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
            <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </button>
      </form>
      <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobileMenu">
      <form class="mobile-search" action="/search" method="get" role="search">
        <label class="visually-hidden" for="mobileSearchInput">Search stories</label>
        <input
          id="mobileSearchInput"
          class="mobile-search-input"
          type="search"
          name="q"
          value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>"
          placeholder="Search stories and guides"
          maxlength="80"
          autocomplete="off"
        >
        <button type="submit" class="mobile-search-submit">Search</button>
      </form>
      <p class="mobile-menu-label">Explore</p>
      <a href="/category/theme-parks" class="<%= typeof category !== 'undefined' && category === 'theme-parks' ? 'active' : '' %>">Theme Parks</a>
      <a href="/guides" class="<%= typeof isGuidesPage !== 'undefined' && isGuidesPage ? 'active' : '' %>">Guides</a>
      <a href="/podcasts" class="<%= typeof isPodcastsPage !== 'undefined' && isPodcastsPage ? 'active' : '' %>">Podcasts</a>
      <a href="/#explore-florida">Explore Florida</a>
      <a href="/merch" class="<%= typeof isMerchPage !== 'undefined' && isMerchPage ? 'active' : '' %>">Merch</a>
      <a href="/sponsors" class="<%= typeof isSponsorsPage !== 'undefined' && isSponsorsPage ? 'active' : '' %>">Sponsorships</a>
      <a href="/wait-times">Wait Times</a>
      <a href="/planner">Day Planner</a>
      <a href="/dining">Dining</a>
      <% if (process.env.BUZZ_BOARD_ENABLED === 'true') { %><a href="/buzz" class="<%= typeof isBuzzPage !== 'undefined' && isBuzzPage ? 'active' : '' %>">Buzz Board</a><% } %>
      <p class="mobile-menu-label">News topics</p>
      <a href="/category/theme-parks" class="<%= typeof category !== 'undefined' && category === 'theme-parks' ? 'active' : '' %>">Theme Parks</a>
      <a href="/category/space" class="<%= typeof category !== 'undefined' && category === 'space' ? 'active' : '' %>">Space</a>
      <a href="/category/beaches" class="<%= typeof category !== 'undefined' && category === 'beaches' ? 'active' : '' %>">Beaches</a>
      <a href="/category/florida-living" class="<%= typeof category !== 'undefined' && category === 'florida-living' ? 'active' : '' %>">Florida Living</a>
      <a href="/category/wildlife" class="<%= typeof category !== 'undefined' && category === 'wildlife' ? 'active' : '' %>">Wildlife</a>
      <a href="/category/cruises" class="<%= typeof category !== 'undefined' && category === 'cruises' ? 'active' : '' %>">Cruises</a>
      <a href="/category/food" class="<%= typeof category !== 'undefined' && category === 'food' ? 'active' : '' %>">Food</a>
      <a href="/category/events" class="<%= typeof category !== 'undefined' && category === 'events' ? 'active' : '' %>">Events</a>
      <a href="/category/travel-deals" class="<%= typeof category !== 'undefined' && category === 'travel-deals' ? 'active' : '' %>">Travel Deals</a>
    </div>
  </nav>

  <script>
    (function () {
      var toggle = document.getElementById('menuToggle');
      var menu = document.getElementById('mobileMenu');
      if (!toggle || !menu) return;
      toggle.addEventListener('click', function () {
        var isOpen = menu.classList.toggle('open');
        toggle.classList.toggle('open', isOpen);
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
      });
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          menu.classList.remove('open');
          toggle.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.setAttribute('aria-label', 'Open menu');
        });
      });
    })();
  </script>
