  <path fill="currentColor" d="M14 8.2h2.4V5H14c-2.3 0-3.8 1.6-3.8 3.9V11H8v3.2h2.2V22h3.3v-7.8H16l.5-3.2h-2.8V9.2c0-.6.3-1 .8-1z"/>
</svg>
